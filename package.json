{
  "name": "kaizen-flow",
  "version": "0.4.0",
  "description": "Kaizen workflow: SPs (user stories) + michi (improvement cycle) for Claude Code, Codex and other agent harnesses",
  "license": "MIT",
  "author": {
    "name": "BMSaiko",
    "url": "https://github.com/BMSaiko"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BMSaiko/kaizen-flow.git"
  },
  "homepage": "https://github.com/BMSaiko/kaizen-flow#readme",
  "bugs": {
    "url": "https://github.com/BMSaiko/kaizen-flow/issues"
  },
  "keywords": [
    "kaizen",
    "workflow",
    "claude-code",
    "codex",
    "agents",
    "user-stories",
    "cli"
  ],
  "bin": {
    "kaizen": "bin/kaizen.js"
  },
  "files": [
    "bin",
    "core",
    "adapters",
    "usage",
    "catalog",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node bin/run-tests.js",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "quality:js": "python core/scripts/quality-ratchet.py --so eslint && python core/scripts/quality-ratchet.py --so tsc"
  },
  "engines": {
    "node": ">=18"
  },
  "coverageThreshold": {
    "js": {
      "lines": 70
    },
    "python": {
      "lines": 90
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^7.0.2"
  }
}
