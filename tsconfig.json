{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "module": "nodenext",
    "target": "es2022",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["bin/**/*.js", "adapters/**/*.js", "tests/**/*.js"],
  "exclude": ["node_modules"]
}
